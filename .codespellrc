[codespell]
skip = .git,*.ipynb,*.csv,*.bundle,datascience_starter_course,__pycache__,.ipynb_checkpoints,*.dat,*.geojson,data_wrangling/data,data_wrangling/solutions,movie*
ignore-words-list = ames,seaborn,sklearn,matplotlib,jupytext,ipynb,ndarray,dataframe,loc,iloc,groupby,concat,fillna,bfill,ffill,dropna,isnull,notnull,nunique,resample,pairplot,heatmap,savefig,figsize,subplots,pyplot,rcParams,inplace,dtype,dtypes,boolean,datetime,timedelta,reindex,linspace,percentile,rng,argmax,argmin,argsort,cumsum,kfold,gridsearchcv,randomforest,logisticregression,linearsvc,standardscaler,columntransformer,simpleimputer,onehotencoder,ordinalencoder,selectkbest,estimator,hyperparameter,overfitting,underfitting,multivariate,multilabel,bagging,boosting,tfidf,vectorizer,tokenizer,pretrained,finetuning,embeddings,softmax,relu,bert,tabpfn,tabicl,titanic,pclass,colab,github,jupyter,nbmake,aspell,pyspelling,narwhals,aarch,boxplot,imshow,manylinux,glibc,stratifiedkfold,multiclass,ridgecv,lassocv,minmaxscaler,whis
quiet-level = 2
